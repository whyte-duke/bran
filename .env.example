# Optional CRM integration only. bran works entirely without this file.
#
# Do NOT keep a real token here. Paste it once into
# bran → Settings → CRM → "Import from a .env file", which stores it in the
# macOS Keychain, then delete your local .env.
#
# Never put a Supabase service_role key on a laptop: it bypasses every security
# rule and grants full read/write access to the whole database. The signed-URL
# flow used by bran grants exactly one capability — write one object, to one
# path, for two hours — and nothing else.

CASTRAL_RECORDER_TOKEN=rec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
