.DS_Store
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# Secrets. Le jeton d'enregistrement vit dans le Trousseau, pas dans le dépôt.
.env
.env.*
!.env.example

# Les worktrees des agents. Du scratch d'outillage, pas du dépôt.
.claude/worktrees/
dist/

# Le moteur de sauvegarde, téléchargé à une version épinglée par
# Scripts/fetch-kopia.sh. 46 Mo par version : ça ne rentre pas dans un dépôt
# dont tout le reste est du texte.
Vendor/
.gstack/

# L'identité de signature exportée par Scripts/make-signing-identity.sh.
# C'est la clé privée qui signe bran : elle vaut exactement ce que valent les
# autorisations d'écran et d'accessibilité qu'elle préserve.
*.p12
